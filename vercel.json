{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server/server.js"
    }
  ],
  "env": {
    "ANTHROPIC_API_KEY": "@anthropic_api_key",
    "YOUTUBE_API_KEY": "@youtube_api_key",
    "INSTAGRAM_ACCESS_TOKEN": "@instagram_access_token",
    "INSTAGRAM_APP_ID": "@instagram_app_id"
  }
}
