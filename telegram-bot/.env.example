# ============================================================
# 빌사남 텔레그램 개발 봇 - 환경변수 템플릿
# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 절대 커밋 금지!
# ============================================================

# ── 필수: 텔레그램 봇 토큰 (@BotFather에서 발급) ──
TELEGRAM_BOT_TOKEN=

# ── 필수: Claude API 키 ──
ANTHROPIC_API_KEY=

# ── 선택: 유튜브 분석 기능에만 필요 ──
YOUTUBE_API_KEY=

# ============================================================
# 🔐 /dev 개발 명령 보안 3중 장치 (전부 설정해야 /dev 활성화)
# ============================================================

# 1단계: 텔레그램 user_id (봇에게 /whoami 보내 확인, 계정=폰 기기 연결됨)
TELEGRAM_OWNER_USER_ID=

# 2단계: chat_id (보통 user_id와 같지만 다를 수 있음)
TELEGRAM_OWNER_CHAT_ID=

# 3단계: PIN (6자 이상, 대소문자/숫자/특수문자 혼합 권장)
# /auth <PIN>으로 로그인 — 틀리면 10분에 3회까지만 시도 가능
DEV_AUTH_PIN=

# 인증 세션 유지 시간 (분). 기본 60분. 만료되면 /auth 재입력 필요
DEV_SESSION_MINUTES=60

# /dev 기본 작업 폴더 (비워두면 봇이 실행된 폴더)
DEV_DEFAULT_CWD=C:\Users\yskbu\OneDrive\Desktop\기타업무\AI

# /dev 작업 최대 실행시간 (밀리초). 기본 10분
DEV_TIMEOUT_MS=600000
